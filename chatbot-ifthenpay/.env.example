# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Chave Multibanco fornecida pela ifthenpay (formato ABC-123456)
IFTHENPAY_MB_KEY=
# Chave anti-phishing definida no backoffice da ifthenpay para o callback
IFTHENPAY_ANTI_PHISHING_KEY=
# true = usa o endpoint de sandbox e ativa o botão "Simular pagamento"
IFTHENPAY_SANDBOX=true
# Dias de validade da referência (vazio = sem prazo)
IFTHENPAY_EXPIRY_DAYS=3

PORT=3000
# DATA_FILE=./data/orders.json
